{
  "name": "dash360technologies",
  "compatibility_date": "2026-09-23",
"routes": [{ "pattern": "dash360tech.com", "custom_domain": true }],
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "admin@torqservicegroup.com"
    }
  ]
}
